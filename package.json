{
  "name": "@j4nn0/meeseeks-box",
  "version": "0.1.0",
  "description": "A cartoon 3D office where your Claude Code and Codex agent sessions go to work.",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "agent-monitoring",
    "agent-visualization",
    "coding-agents",
    "developer-tools",
    "threejs",
    "rick-and-morty",
    "meeseeks"
  ],
  "homepage": "https://github.com/J4NN0/meeseeks-box#readme",
  "bugs": "https://github.com/J4NN0/meeseeks-box/issues",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/J4NN0/meeseeks-box.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "bin": {
    "meeseeks-box": "server/cli.js",
    "claude-box": "bin/claude-box"
  },
  "files": [
    "bin",
    "dist",
    "server"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "serve": "vite build && node server/index.js",
    "build:site": "vite build --mode demo",
    "preview:site": "vite build --mode demo && vite preview --mode demo",
    "prepack": "vite build",
    "release": "sh scripts/release.sh"
  },
  "devDependencies": {
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "three": "^0.186.1",
    "vite": "^8.3.1"
  }
}
